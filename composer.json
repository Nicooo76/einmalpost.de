{
    "name": "einmalpost/einmalpost",
    "description": "Überträgt ein Geheimnis genau einmal und vergisst es danach.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Einmalpost\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Einmalpost\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "stan": "phpstan analyse --memory-limit=512M",
        "unit": "phpunit --testsuite unit",
        "integration": "phpunit --testsuite integration"
    }
}
